{
  "name": "manage_meme",
  "display_name": "管理表情包",
  "description": "维护当前人格的可写表情库。action=add 导入本地图片，未给元数据时由配置的识图模型生成；action=update 改可写覆盖层里的元数据；action=delete 删除用户表情或禁用内置表情，hard_delete=true 才永久删文件。",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "add",
          "update",
          "delete"
        ],
        "description": "add 导入，update 改元数据，delete 删除。"
      },
      "image": {
        "type": "string",
        "description": "add：本地图片路径。"
      },
      "id": {
        "type": "string",
        "description": "update/delete：完整 sha256 id 或唯一短 id。"
      },
      "library": {
        "type": "string",
        "description": "可选表情库覆盖。"
      },
      "name_zh": {
        "type": "string",
        "description": "中文名。"
      },
      "name_en": {
        "type": "string",
        "description": "英文名。"
      },
      "description": {
        "type": "string",
        "description": "可见内容描述。"
      },
      "usage": {
        "type": "string",
        "description": "什么时候用。"
      },
      "avoid": {
        "type": "string",
        "description": "什么时候别用。"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "检索标签。"
      },
      "enabled": {
        "type": "boolean",
        "description": "update：启用或禁用。"
      },
      "hard_delete": {
        "type": "boolean",
        "description": "delete：永久删除而不是移入回收站。"
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "always_loaded": false,
  "load_policy": "group",
  "groups": [
    "memes"
  ]
}
