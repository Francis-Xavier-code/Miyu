{
  "name": "todowrite",
  "display_name": "任务列表",
  "description": "维护当前会话的任务列表：传 todos 整表替换，传 updates 做增量变更。\n二者必须且只能给一个。updates 支持 add/update/remove/clear，可用 index（1 起始）或 match_content 定位目标。",
  "parameters": {
    "type": "object",
    "properties": {
      "todos": {
        "type": "array",
        "description": "完整任务列表。此操作会替换整个列表。",
        "items": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "description": "任务简述。"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "cancelled"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          },
          "required": [
            "content",
            "status",
            "priority"
          ]
        }
      },
      "updates": {
        "type": "array",
        "description": "按顺序原子应用的任务变更。",
        "items": {
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "add",
                "update",
                "remove",
                "clear"
              ]
            },
            "index": {
              "type": "integer",
              "description": "目标任务序号，1 起始。新增时表示插入位置；省略则追加。"
            },
            "match_content": {
              "type": "string",
              "description": "省略 index 时，用于定位目标任务的完整内容。"
            },
            "content": {
              "type": "string",
              "description": "新增或修改后的任务内容。"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "completed",
                "cancelled"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            }
          },
          "required": [
            "action"
          ]
        }
      }
    }
  },
  "permission": "writes",
  "always_loaded": false,
  "load_policy": "summary",
  "groups": [
    "planning"
  ]
}
