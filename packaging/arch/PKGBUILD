# Maintainer: shorinkiwata <fcl709@outlook.com>
pkgname=miyu-git
pkgver=0.3.0.r50.gf83e9d6
pkgrel=1
pkgdesc="以深度集成、沉浸感、拟真为卖点的 Rust AI agent（REPL / WebUI / QQ 群集成）"
arch=('x86_64' 'aarch64')
url="https://github.com/SHORiN-KiWATA/Miyu"
license=('MIT')
depends=('gcc-libs' 'glibc' 'alsa-lib')
makedepends=('git' 'cargo')
optdepends=('chafa: 终端内联图片预览'
            'matugen: WebUI 主题跟随系统配色')
provides=('miyu')
conflicts=('miyu')
# ring / 捆绑 sqlite3 的 C 对象与 makepkg 注入的 GCC -flto 不兼容
# （rust-lld 读不了 GCC LTO 字节码，链接时符号未定义）。
options=('!lto')
source=("miyu::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd miyu
  git describe --long --abbrev=7 --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd miyu
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd miyu
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd miyu
  export RUSTUP_TOOLCHAIN=stable
  # muted_bot… 是已知的时段相关 flaky 测试（凌晨/晚间构建会失败），与构建产物无关。
  cargo test --frozen --release -- \
    --skip muted_bot_suppresses_direct_group_trigger_while_unknown_fails_open
}

package() {
  cd miyu
  install -Dm755 target/release/miyu "$pkgdir/usr/bin/miyu"

  # 长回复转图片的渲染字体：运行时从 /usr/share/miyu/fonts 加载，
  # 缺失时该功能会静默退化为纯文本。
  install -Dm644 assets/fonts/NotoSansCJK-Regular.ttc -t "$pkgdir/usr/share/miyu/fonts/"
  install -Dm644 assets/fonts/NotoColorEmoji.ttf -t "$pkgdir/usr/share/miyu/fonts/"

  # 内置表情库（src/tools/memes.rs 的 BUILTIN_MEMES_DIR）。
  install -dm755 "$pkgdir/usr/share/miyu/memes"
  cp -r src/memes/miyu "$pkgdir/usr/share/miyu/memes/miyu"
  find "$pkgdir/usr/share/miyu/memes" -type d -exec chmod 755 {} +
  find "$pkgdir/usr/share/miyu/memes" -type f -exec chmod 644 {} +

  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 assets/fonts/NotoSansCJK.LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 assets/fonts/NotoColorEmoji.LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
